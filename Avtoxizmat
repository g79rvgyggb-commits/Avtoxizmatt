<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Auto Tuning</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root {
    --bg: #0f1115; --card: #181b22; --line: #262a33;
    --text: #eceef2; --muted: #8b92a1; --accent: #ff5a36;
  }
  * { box-sizing: border-box; margin: 0; -webkit-tap-highlight-color: transparent; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); padding-bottom: 40px; }
  header { padding: 22px 16px 8px; }
  header h1 { font-size: 24px; letter-spacing: -0.5px; }
  header h1 span { color: var(--accent); }
  header p { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .search { margin: 12px 16px; }
  .search input { width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--text); font-size: 15px; outline: none; }
  .search input:focus { border-color: var(--accent); }
  .chips { display: flex; gap: 8px; overflow-x: auto; padding: 4px 16px 12px; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chip { flex: none; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--muted); font-size: 14px; cursor: pointer; }
  .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .list { display: grid; gap: 12px; padding: 0 16px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px; cursor: pointer; transition: transform .1s; }
  .card:active { transform: scale(.98); }
  .card .top { display: flex; align-items: center; gap: 12px; }
  .icon { width: 44px; height: 44px; border-radius: 12px; background: #23262f; display: grid; place-items: center; font-size: 22px; flex: none; }
  .card h3 { font-size: 16px; }
  .card .cat { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .card p { color: var(--muted); font-size: 14px; margin-top: 10px; line-height: 1.45; }
  .meta { display: flex; justify-content: space-between; margin-top: 12px; font-size: 13px; }
  .price { color: var(--accent); font-weight: 600; }
  .level { color: var(--muted); }
  .empty { text-align: center; color: var(--muted); padding: 40px 16px; }
  /* tafsilot oynasi */
  .sheet-bg { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: flex-end; z-index: 10; }
  .sheet-bg.open { display: flex; }
  .sheet { background: var(--card); width: 100%; max-height: 85vh; overflow-y: auto; border-radius: 22px 22px 0 0; padding: 22px 18px 34px; animation: up .22s ease; }
  @keyframes up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .sheet h2 { font-size: 20px; margin: 10px 0 4px; }
  .sheet .big { font-size: 34px; }
  .sheet ul { margin: 14px 0 0 18px; color: var(--text); line-height: 1.7; font-size: 14px; }
  .row { display: flex; gap: 10px; margin-top: 16px; }
  .box { flex: 1; background: #20232b; border-radius: 12px; padding: 12px; }
  .box small { color: var(--muted); display: block; font-size: 12px; }
  .box b { font-size: 15px; }
  .close { margin-top: 20px; width: 100%; padding: 14px; border: none; border-radius: 12px; background: var(--accent); color: #fff; font-size: 16px; font-weight: 600; }
</style>
</head>
<body>

<header>
  <h1>Auto <span>Tuning</span></h1>
  <p>Mashinangizni sozlash bo'yicha qo'llanma</p>
</header>

<div class="search"><input id="q" placeholder="Qidirish: masalan, turbo, disk..."></div>
<div class="chips" id="chips"></div>
<div class="list" id="list"></div>

<div class="sheet-bg" id="bg"><div class="sheet" id="sheet"></div></div>

<script>
/* ============================================================
   YANGI QO'SHIMCHA QO'SHISH: pastdagi ro'yxatga shu shaklda
   bitta blok qo'shing va vergul qo'yishni unutmang.
   ============================================================ */
const DATA = [
  {
    cat: "Dvigatel", icon: "⚙️", title: "Chip-tyuning (ECU)",
    desc: "Dvigatel kompyuteri dasturini o'zgartirib, quvvat va moment oshiriladi.",
    price: "$150 – $600", level: "O'rtacha",
    gain: "+10–25% quvvat",
    tips: ["Faqat tajribali ustaga ishoning", "Avval dvigatel holatini tekshirtiring", "Yoqilg'i sifatiga e'tibor bering"]
  },
  {
    cat: "Dvigatel", icon: "🌀", title: "Sport havo filtri",
    desc: "Nol qarshilikli filtr havoni yaxshiroq o'tkazadi va dvigatel ovozini boyitadi.",
    price: "$30 – $120", level: "Oson",
    gain: "+2–5% quvvat",
    tips: ["O'rnatish 15 daqiqa", "Muntazam tozalab turish kerak", "Changli yo'llarda tez ifloslanadi"]
  },
  {
    cat: "Dvigatel", icon: "🔊", title: "Sport glushitel",
    desc: "To'g'ri oqimli tizim chiqish qarshiligini kamaytiradi va ovozni chuqurlashtiradi.",
    price: "$100 – $500", level: "O'rtacha",
    gain: "Ovoz + biroz quvvat",
    tips: ["Shovqin qonun chegarasidan oshmasin", "Zanglamas po'latni tanlang", "Payvandlash sifatiga qarang"]
  },
  {
    cat: "Podveska", icon: "🔧", title: "Pasaytirilgan prujinalar",
    desc: "Mashinani 25–40 mm pasaytirib, burilishda turg'unlikni oshiradi.",
    price: "$80 – $250", level: "O'rtacha",
    gain: "Yaxshi boshqaruv",
    tips: ["Amortizatorlarni ham almashtiring", "O'rnatgach razval-sxodimlik qiling", "Yo'l notekisligini hisobga oling"]
  },
  {
    cat: "Podveska", icon: "📏", title: "Koylover (rostlanadigan podveska)",
    desc: "Balandlik va qattiqlikni o'zingizga moslab sozlash imkonini beradi.",
    price: "$400 – $1500", level: "Murakkab",
    gain: "To'liq nazorat",
    tips: ["Sifatli brendni tanlang", "Kundalik haydash uchun juda qattiq qilmang", "Ustaxonada sozlating"]
  },
  {
    cat: "Tormoz", icon: "🛑", title: "Teshikli tormoz disklari",
    desc: "Issiqlik va changni tezroq chiqaradi, qattiq tormozlashda barqaror ishlaydi.",
    price: "$120 – $450", level: "O'rtacha",
    gain: "Ishonchli tormoz",
    tips: ["Disk bilan kolodkani birga almashtiring", "Dastlabki 200 km ehtiyotkor haydang", "Tormoz suyuqligini yangilang"]
  },
  {
    cat: "G'ildirak", icon: "🛞", title: "Legkosplav disklar",
    desc: "Yengil disklar mashina vaznini kamaytiradi va tashqi ko'rinishni yaxshilaydi.",
    price: "$200 – $1200", level: "Oson",
    gain: "Dizayn + yengillik",
    tips: ["Teshik oralig'i (PCD) mos bo'lsin", "Diametr haddan oshmasin", "Past profilli rezina yo'lni his qildiradi"]
  },
  {
    cat: "Tashqi ko'rinish", icon: "🎨", title: "Plyonka (vinil o'rash)",
    desc: "Bo'yamasdan rangni o'zgartirish, kuzovni toshlardan himoya qilish.",
    price: "$300 – $1500", level: "Oson",
    gain: "Yangi ko'rinish",
    tips: ["Sifatli plyonka 3–5 yil xizmat qiladi", "Avval kuzovni yaxshilab tozalang", "Olib tashlash mumkin, bo'yoq saqlanadi"]
  },
  {
    cat: "Tashqi ko'rinish", icon: "💡", title: "LED / Bi-LED faralar",
    desc: "Yorug'likni kuchaytirib, tungi ko'rinuvchanlik va ko'rinishni yaxshilaydi.",
    price: "$60 – $400", level: "O'rtacha",
    gain: "Yaxshi yorug'lik",
    tips: ["Ko'zgu uchun mos linzali turini tanlang", "Qarshi yo'ldagilarni ko'r qilmasin", "Sertifikatli mahsulot oling"]
  },
  {
    cat: "Salon", icon: "🔈", title: "Audio tizim va shovqin izolyatsiyasi",
    desc: "Dinamiklar, sabvufer va vibroizolyatsiya salonni jim va ovozni sifatli qiladi.",
    price: "$150 – $900", level: "O'rtacha",
    gain: "Qulaylik",
    tips: ["Avval izolyatsiya, keyin audio", "Akkumulyator quvvatini hisoblang", "Dinamik o'lchamlariga e'tibor bering"]
  }
];

const ALL = "Hammasi";
let activeCat = ALL, query = "";
const $ = id => document.getElementById(id);
const tg = window.Telegram && window.Telegram.WebApp;
if (tg) { tg.ready(); tg.expand(); }

function renderChips() {
  const cats = [ALL, ...new Set(DATA.map(d => d.cat))];
  $("chips").innerHTML = cats.map(c =>
    `<div class="chip ${c === activeCat ? "active" : ""}" data-c="${c}">${c}</div>`).join("");
  document.querySelectorAll(".chip").forEach(el => el.onclick = () => {
    activeCat = el.dataset.c; renderChips(); renderList();
  });
}

function renderList() {
  const items = DATA.map((d, i) => ({ ...d, i })).filter(d =>
    (activeCat === ALL || d.cat === activeCat) &&
    (d.title + d.desc + d.cat).toLowerCase().includes(query.toLowerCase()));
  $("list").innerHTML = items.length ? items.map(d => `
    <div class="card" data-i="${d.i}">
      <div class="top">
        <div class="icon">${d.icon}</div>
        <div><h3>${d.title}</h3><div class="cat">${d.cat}</div></div>
      </div>
      <p>${d.desc}</p>
      <div class="meta"><span class="price">${d.price}</span><span class="level">${d.level}</span></div>
    </div>`).join("") : `<div class="empty">Hech narsa topilmadi</div>`;
  document.querySelectorAll(".card").forEach(el => el.onclick = () => openSheet(+el.dataset.i));
}

function openSheet(i) {
  const d = DATA[i];
  $("sheet").innerHTML = `
    <div class="big">${d.icon}</div>
    <h2>${d.title}</h2>
    <div style="color:var(--muted);font-size:14px">${d.desc}</div>
    <div class="row">
      <div class="box"><small>Narxi</small><b>${d.price}</b></div>
      <div class="box"><small>Qiyinligi</small><b>${d.level}</b></div>
    </div>
    <div class="row"><div class="box"><small>Natija</small><b>${d.gain}</b></div></div>
    <ul>${d.tips.map(t => `<li>${t}</li>`).join("")}</ul>
    <button class="close" id="closeBtn">Yopish</button>`;
  $("bg").classList.add("open");
  $("closeBtn").onclick = closeSheet;
  if (tg && tg.HapticFeedback) tg.HapticFeedback.impactOccurred("light");
}
function closeSheet() { $("bg").classList.remove("open"); }
$("bg").onclick = e => { if (e.target === $("bg")) closeSheet(); };
$("q").oninput = e => { query = e.target.value; renderList(); };

renderChips(); renderList();
</script>
</body>
</html>
